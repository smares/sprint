includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5

    # Read the types of date, enum and other casts from the casts() methods of the models.
    parseModelCastsMethod: true

    paths:
        - app
        - config
        - database
        - routes

    # Type information from PHPDoc is trusted less than native types, which avoids
    # false "always true/false" reports on values that PHPDoc narrows too far.
    treatPhpDocTypesAsCertain: false

    # The baseline is shared by all PHP versions of the CI; a version that no longer
    # reports an old error must not fail because of it.
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # The traits are used by the Livewire single-file components in resources/views,
        # which PHPStan does not analyse.
        -
            identifier: trait.unused
            path: app/Concerns/*
