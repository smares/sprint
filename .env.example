APP_NAME=Sprint
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Europe/Berlin
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In production behind HTTPS:
# SESSION_SECURE_COOKIE=true
# Behind a proxy or load balancer that terminates TLS: its addresses (comma-separated) or *
# TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
# Live updates (board, lists, task page, inbox, who else is looking): switch on with
# BROADCAST_CONNECTION=reverb, fill in the values below and run `php artisan reverb:start` (see docs/configuration.md)
# REVERB_APP_ID=sprint
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=8080
# Only if the app reaches Reverb differently than the browser (e.g. Docker): REVERB_INTERNAL_HOST, REVERB_INTERNAL_PORT, REVERB_INTERNAL_SCHEME
FILESYSTEM_DISK=local
# Docker build only: Flux Pro credentials for Composer (see docs/deployment-docker.md)
# COMPOSER_AUTH='{"http-basic":{"composer.fluxui.dev":{"username":"you@example.com","password":"license-key"}}}'
# Nightly backup of database and attachments (see docs/maintenance.md)
# BACKUP_ENABLED=true
# BACKUP_DISK=backups
# BACKUP_TIME=02:30
# BACKUP_KEEP_DAYS=14
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Push notifications (optional): php artisan webpush:vapid --show, then never change them
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
